<idea-plugin>
    <id>me.devnatan.inventoryframework.intellij</id>
    <name>Inventory Framework</name>
    <vendor url="https://github.com/DevNatan/inventory-framework">DevNatan</vendor>

    <description><![CDATA[
        Live preview for inventory-framework views.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends optional="true" config-file="inventoryframework-kotlin.xml">org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider implementation="me.devnatan.inventoryframework.intellij.InventoryPreviewFileEditorProvider"/>
        <applicationConfigurable
            parentId="tools"
            instance="me.devnatan.inventoryframework.intellij.MinecraftIconSettingsConfigurable"
            id="me.devnatan.inventoryframework.intellij.MinecraftIconSettingsConfigurable"
            displayName="Inventory Framework"/>
        <localInspection
            language=""
            groupName="Inventory Framework"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="me.devnatan.inventoryframework.intellij.ExperimentalApiUsageInspection"
            displayName="Usage of experimental or internal inventory-framework API"/>
    </extensions>
</idea-plugin>
